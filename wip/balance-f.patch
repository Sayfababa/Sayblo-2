+++ b/src/sim/retreat.ts
@@ -0,0 +1,61 @@
+/**
+ * Package F: no death loops. When the hero dies `deaths` times in the same area without clearing it, auto-advance holds
+ * one area back (on the first area of a difficulty: the last area of the difficulty below) until the hero gains
+ * `levels` levels or slays `kills` monsters. Numbers in src/content/hero.json › death.retreat. Rifts have their own rule.
+ */
+import { AREAS, HERO } from '../content/index.ts';
+import type { Sim } from './sim.ts';
+import type { SaveState } from './types.ts';
+
+const R = HERO.death.retreat;
+
+/** Is auto-advance into area `z` of difficulty `d` on hold? */
+export function held(s: SaveState, d: number, z: number): boolean {
+  const h = s.retreat;
+  return !!h?.held && (d > h.hd || (d === h.hd && z >= h.hz));
+}
+
+/**
+ * On a death outside rifts: count it and pick the area to return to (one back, as before). Returns the zone; may lower
+ * the difficulty when the hold starts on the first area of a difficulty.
+ */
+export function retreatOnDeath(sim: Sim): number {
+  const s = sim.s, d = s.difficulty, z = s.zone;
+  const r = (s.retreat ??= { d, z, n: 0, held: false, hd: d, hz: z, lvl: s.lvl, kills: s.kills });
+  if (r.d !== d || r.z !== z) { r.d = d; r.z = z; r.n = 0; }
+  r.n++;
+  if (!s.autoReturn || r.n < R.deaths) return Math.max(0, z - 1);
+  // too many deaths here: hold auto-advance below this area
+  r.held = true; r.n = 0; r.lvl = s.lvl; r.kills = s.kills; r.hd = d; r.hz = z;
+  s.retreats++;
+  if (z > 0) {
+    sim.log(`Too many deaths in **${AREAS[z].name}**. Auto-advance waits one area back until you are stronger (a level up or ${R.kills} kills).`, 'bad');
+    return z - 1;
+  }
+  if (d > 0) {
+    s.difficulty = d - 1;
+    sim.recalc();
+    sim.dirty.add('town'); sim.dirty.add('zones');
+    const back = Math.max(0, (s.progress[d - 1] || 1) - 1);
+    sim.log(`Too many deaths in **${AREAS[z].name}**. Back to the last area of the difficulty below until you are stronger (a level up or ${R.kills} kills).`, 'bad');
+    return back;
+  }
+  return 0;
+}
+
+/** After a level up or a kill: the hero got stronger, the hold ends. */
+export function retreatCheck(sim: Sim) {
+  const s = sim.s, r = s.retreat;
+  if (!r?.held) return;
+  if (s.lvl >= r.lvl + R.levels || s.kills >= r.kills + R.kills) {
+    r.held = false;
+    sim.log(`You feel ready for **${AREAS[r.hz]?.name ?? 'the next area'}** again. Auto-advance resumes.`, 'lvl');
+    sim.dirty.add('zones');
+  }
+}
+
+/** An area was cleared: deaths there no longer count. */
+export function retreatCleared(s: SaveState, d: number, z: number) {
+  const r = s.retreat;
+  if (r && r.d === d && r.z === z) r.n = 0;
+}
