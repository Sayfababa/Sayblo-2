diff --git a/src/sim/stall.ts b/src/sim/stall.ts
new file mode 100644
index 0000000..1cd7e49
--- /dev/null
+++ b/src/sim/stall.ts
@@ -0,0 +1,45 @@
+/**
+ * Package F: every fight must end. Monsters heal and shield each other only up to fixed rates, and a monster that
+ * stays alive too long becomes Exhausted (no more healing or shields, its ward crumbles, it takes rising damage).
+ * Numbers in src/content/monsters.json › fightLimits. Pure state changes, no randomness.
+ */
+import { FIGHT_LIMITS } from '../content/index.ts';
+import type { Monster } from './types.ts';
+
+const F = FIGHT_LIMITS, X = F.exhaust;
+
+/** Seconds a monster may live before it is Exhausted. */
+export const exhaustAfter = (m: Monster) => (m.rank >= 3 || m.rg ? X.bossAfter : X.after);
+/** Is the monster past its time? */
+export const exhausted = (m: Monster) => (m.fe?.age ?? 0) > exhaustAfter(m);
+/** Damage taken factor of an Exhausted monster (1 before). */
+export function exhaustTaken(m: Monster): number {
+  const over = (m.fe?.age ?? 0) - exhaustAfter(m);
+  return over > 0 ? 1 + Math.min(X.takenMax, over * X.takenPerSecond) : 1;
+}
+
+/** Per tick for every living monster in a fight (also frozen ones): age, heal budget, shield lockout, crumbling ward. */
+export function fightStep(m: Monster, dt: number) {
+  const fe = (m.fe ??= {});
+  fe.age = (fe.age ?? 0) + dt;
+  const cap = m.maxHp * F.vampPerSecond;
+  fe.vb = Math.min(cap, (fe.vb ?? cap) + cap * dt);
+  if (fe.shT) fe.shT = Math.max(0, fe.shT - dt);
+  if (m.ward > 0 && exhausted(m)) m.ward = Math.max(0, m.ward - Math.max(1, m.maxWard) * X.wardDecay * dt);
+}
+
+/** Vampiric healing of `amount`, limited by the per-second budget; Exhausted monsters do not heal. */
+export function vampHeal(m: Monster, amount: number) {
+  if (m.hp <= 0 || amount <= 0 || exhausted(m)) return;
+  const fe = (m.fe ??= {}), cap = m.maxHp * F.vampPerSecond, b = fe.vb ?? cap, h = Math.min(b, amount);
+  fe.vb = b - h;
+  m.hp = Math.min(m.maxHp, m.hp + h);
+}
+
+/** May this monster take a Shielding ward now? Starts the lockout when it does. */
+export function takeShield(m: Monster): boolean {
+  const fe = (m.fe ??= {});
+  if ((fe.shT ?? 0) > 0 || exhausted(m)) return false;
+  fe.shT = F.shieldLockout;
+  return true;
+}
