--- /dev/null
+++ b/scripts/balance.ts
@@ -0,0 +1,78 @@
+/**
+ * Balance report (package F): lets the bot (scripts/bot.ts) play whole careers and prints progress, deaths and the
+ * longest fight per build, averaged over seeds.
+ *
+ *   node scripts/balance.ts [hours=8] [seeds=1,2,3] [builds=fire,lance,cold,storm,wfire,wcold,wstorm] [--career] [--every 2] [--csv]
+ *
+ * Campaign: the bot walks Normal → Nightmare → Hell (it steps back when it dies too often, see bot.ts).
+ * --career: after Mother Vesper falls on Hell the bot switches to rifts in auto mode (keys, tiers) and keeps going.
+ * Columns per checkpoint: lvl = level, stage = furthest area unlocked (N/NM/H + area 1-6) or best rift tier, d/h = deaths
+ * per hour since the last checkpoint. Milestones: hours until Mother Vesper falls on Normal / Nightmare / Hell, level 60.
+ */
+import { DIFFICULTIES, AREAS } from '../src/content/index.ts';
+import { Sim } from '../src/sim/sim.ts';
+import { newSaveState } from '../src/sim/state.ts';
+import { Bot } from './bot.ts';
+import { planClass } from './endgame.ts';
+
+const args = process.argv.slice(2), flag = (k: string) => { const i = args.indexOf(k); if (i < 0) return null; const v = args[i + 1]; args.splice(i, 2); return v; };
+const bool = (k: string) => { const i = args.indexOf(k); if (i < 0) return false; args.splice(i, 1); return true; };
+const career = bool('--career'), csv = bool('--csv'), every = Number(flag('--every') ?? 2);
+const hours = Number(args[0] ?? 8), seeds = (args[1] ?? '1,2,3').split(',').map(Number);
+const builds = (args[2] ?? 'fire,lance,cold,storm,wfire,wcold,wstorm').split(',');
+
+interface Point { h: number; lvl: number; stage: number; tier: number; deaths: number; xpPct: number }
+interface Run { pts: Point[]; vesper: (number | null)[]; lvl60: number | null; maxFight: number; riftFails: number; riftRuns: number; deaths: number; stepBacks: number }
+
+const stageIdx = (sim: Sim) => {
+  let best = 0;
+  for (let d = 0; d < DIFFICULTIES.length; d++) if (sim.s.progress[d]) best = d * AREAS.length + sim.s.progress[d];
+  return best;
+};
+const stageName = (i: number) => i <= 0 ? '-' : `${['N', 'NM', 'H'][Math.floor((i - 1) / AREAS.length)]}${((i - 1) % AREAS.length) + 1}`;
+
+function play(build: string, seed: number): Run {
+  const sim = new Sim(newSaveState(planClass(build)), { seed, headless: true });
+  const bot = new Bot(sim, build);
+  const vesper: (number | null)[] = DIFFICULTIES.map(() => null);
+  let t = 0, lvl60: number | null = null, maxFight = 0, inRift = false;
+  const orig = sim.rift.onActBoss.bind(sim.rift);
+  sim.rift.onActBoss = (d: number) => { if (vesper[d] == null) vesper[d] = t / 3600; orig(d); };
+  const pts: Point[] = [];
+  let d0 = 0;
+  for (let h = every; h <= hours; h += every) {
+    for (; t < h * 3600; t += 5) {
+      sim.advance(5);
+      bot.step();
+      maxFight = Math.max(maxFight, (sim as unknown as { fightT?: number }).fightT ?? 0);
+      if (lvl60 == null && sim.s.lvl >= 60) lvl60 = t / 3600;
+      if (career && !inRift && vesper[DIFFICULTIES.length - 1] != null && sim.phase !== 'town') {
+        inRift = true; bot.opts.rift = true; sim.s.rift.auto = true; sim.rift.startFree();
+      }
+    }
+    pts.push({ h, lvl: sim.s.lvl, stage: stageIdx(sim), tier: sim.s.rift.maxTier, deaths: (sim.s.deaths - d0) / every, xpPct: sim.s.xp });
+    d0 = sim.s.deaths;
+  }
+  return { pts, vesper, lvl60, maxFight, riftFails: sim.rift.stats.fails, riftRuns: sim.rift.stats.runs, deaths: sim.s.deaths, stepBacks: ((bot as unknown as { stepBacks?: number }).stepBacks ?? 0) + ((sim.s as unknown as { retreats?: number }).retreats ?? 0) };
+}
+
+const avg = (xs: number[]) => xs.reduce((a, b) => a + b, 0) / Math.max(1, xs.length);
+const f1 = (x: number) => (Math.round(x * 10) / 10).toFixed(1);
+const fm = (xs: (number | null)[]) => xs.map(x => x == null ? '  -  ' : f1(x).padStart(5)).join(' ');
+
+if (!csv) console.log(`balance · ${hours} h · seeds ${seeds.join(',')}${career ? ' · career (rifts after Hell)' : ''}`);
+for (const build of builds) {
+  const runs = seeds.map(s => play(build, s));
+  if (csv) {
+    runs.forEach((r, i) => r.pts.forEach(p => console.log([build, seeds[i], p.h, p.lvl, stageName(p.stage), p.tier, f1(p.deaths), ...r.vesper.map(v => v == null ? '' : f1(v)), r.lvl60 == null ? '' : f1(r.lvl60), Math.round(r.maxFight)].join(','))));
+    continue;
+  }
+  console.log(`\n=== ${build} ===`);
+  console.log('   h   lvl   stage(per seed)       tier   d/h(per seed)');
+  for (let i = 0; i < runs[0].pts.length; i++) {
+    const ps = runs.map(r => r.pts[i]);
+    console.log(`${String(ps[0].h).padStart(4)}  ${f1(avg(ps.map(p => p.lvl))).padStart(5)}   ${ps.map(p => stageName(p.stage).padEnd(4)).join(' ').padEnd(20)} ${f1(avg(ps.map(p => p.tier))).padStart(5)}   ${ps.map(p => f1(p.deaths).padStart(4)).join(' ')}  avg ${f1(avg(ps.map(p => p.deaths)))}`);
+  }
+  console.log(`  Vesper N/NM/H (h, per seed): ${runs.map(r => fm(r.vesper)).join(' | ')}`);
+  console.log(`  level 60 at (h): ${runs.map(r => r.lvl60 == null ? '-' : f1(r.lvl60)).join(', ')} · deaths ${runs.map(r => r.deaths).join(', ')} · step-backs ${runs.map(r => r.stepBacks).join(', ')} · longest fight ${Math.round(Math.max(...runs.map(r => r.maxFight)))} s${career ? ` · rifts ${runs.map(r => `${r.riftRuns} ok/${r.riftFails} died`).join(', ')}` : ''}`);
+}
